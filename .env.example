# ---------------------------------------------------------------------------
# SomNOG9 EMS - copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres -------------------------------------------------------------
# One instance, one schema per service. Nothing reads another service's schema.
POSTGRES_USER=somnog
POSTGRES_PASSWORD=somnog
POSTGRES_DB=somnog_ems

AUTH_DATABASE_URL="postgresql://somnog:somnog@localhost:5433/somnog_ems?schema=auth"
EVENTS_DATABASE_URL="postgresql://somnog:somnog@localhost:5433/somnog_ems?schema=events"
NOTIFY_DATABASE_URL="postgresql://somnog:somnog@localhost:5433/somnog_ems?schema=notify"

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
AUTH_QUEUE=auth_queue
EVENTS_QUEUE=events_queue
NOTIFICATION_QUEUE=notification_queue
EVENTS_EXCHANGE=somnog.events

# --- Redis (BullMQ retry queue for notifications) -------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ------------------------------------------------------------------
# Change these in production. ACCESS is short-lived, REFRESH is rotated.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Ports ----------------------------------------------------------------
GATEWAY_PORT=3000
AUTH_HEALTH_PORT=3001
EVENTS_HEALTH_PORT=3002
NOTIFICATION_HEALTH_PORT=3003

# --- Mail (MailHog locally) ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SomNOG Events <no-reply@somnog.so>"

# --- App ------------------------------------------------------------------
APP_WEB_URL=http://localhost:4200
DEFAULT_TIMEZONE=Africa/Mogadishu
THROTTLE_TTL=60
THROTTLE_LIMIT=100
