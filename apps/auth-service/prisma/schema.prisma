// Authentication service - owns identity and nothing else.
//
// It does NOT know which events a user attends. Per-event permissions live in
// the events service, keyed by this User.id. Putting them here is the most
// common microservice mistake: it drags event logic into auth.

generator client {
  provider = "prisma-client"

  // Prisma 7 generates the client as TypeScript into your own source tree.
  // Inside src/ so tsc compiles it into dist/ with everything else - no asset
  // copying, and no shared node_modules copy for three schemas to fight over.
  output = "../src/generated/prisma"

  // NestJS is CommonJS. Without this the client emits ESM and nothing resolves.
  moduleFormat = "cjs"
  runtime      = "nodejs"

  // Extensionless imports, which is what tsc + CommonJS expects.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
  // Prisma 7 no longer accepts `url` here. The CLI reads it from
  // prisma.config.ts (AUTH_DATABASE_URL, ending in ?schema=auth); the running
  // service gets it through the driver adapter in PrismaService.
}

enum UserRole {
  ADMIN
  ORGANIZER
  SPEAKER
  ATTENDEE
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  affiliation   String?
  country       String?
  phone         String?
  role          UserRole  @default(ATTENDEE)
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored hashed: a leaked database row must not be a usable session.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}
